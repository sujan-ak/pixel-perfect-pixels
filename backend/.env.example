# Server & CORS
PORT=8000
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# LLM providers (existing)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
HF_TOKEN=

# DB (read database/__init__.py + supabase_backend.py for the exact names)
DB_BACKEND=sqlite
DATABASE_PATH=aurashield.db
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (existing) — leave blank
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_FROM_NUMBER=
TWILIO_POLICE_TO=
TWILIO_DISPATCH_TO=
TWILIO_HOSPITAL_ALPHA_TO=
TWILIO_HOSPITAL_BETA_TO=

# Android SMS Gateway (Local SIM Gateway via capcom6/android-sms-gateway)
AURASHIELD_SMS_ENABLED=0
SMS_GATEWAY_URL=http://<ANDROID_PHONE_IP>:<PORT>
SMS_GATEWAY_USER=<username>
SMS_GATEWAY_PASS=<password>
POLICE_PHONE=
HOSPITAL_PHONE=

# Hindsight (NEW)
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=aurashield-ops
MEMORY_ENABLED=1
MEMORY_LOCAL_LEDGER=backend/data/memory_ledger.jsonl
MEMORY_MIN_PRECEDENTS=3
MEMORY_MAX_ADJUST=0.25
